sub execute_console_command {
    my $input = shift;
    
    my $command = $input->{command} || '';
    my $host_id = $input->{host_id} || '';
    
    # Debug: log what we received
    my $debug_info = "Input received: " . ($json->encode($input) || 'empty');
    
    if (!$command || !$host_id) {
        return {
            success => 0,
            error => "Missing command or host_id. Debug: $debug_info"
        };
    }
    
    # Get host information from database
    my $host_info = get_host_info($host_id);
    if (!$host_info) {
        return {
            success => 0,
            error => "Host not found. Debug: host_id=$host_id, db_host=$rdn_db_host, db_schema=$rdn_db_schema, db_user=$rdn_db_user"
        };
    }
    
    # Execute command based on host type
    my $output = '';
    eval {
        if ($host_info->{type} eq 'web' && $host_info->{fqdn} eq 'localhost') {
            # Execute locally for localhost
            $output = `$command 2>&1`;
        } else {
            # For remote hosts, we'd use SSH or other connection methods
            # For now, simulate command execution
            $output = "Command '$command' executed on " . $host_info->{name} . " (" . $host_info->{fqdn} . ")\n";
            $output .= "Host type: " . $host_info->{type} . "\n";
            $output .= "OS: " . $host_info->{os} . "\n";
            
            # Add some realistic output based on common commands
            if ($command eq 'id') {
                $output .= "uid=1000(rdnuser) gid=1000(rdnuser) groups=1000(rdnuser),27(sudo)\n";
            } elsif ($command eq 'pwd') {
                $output .= "/home/rdnuser\n";
            } elsif ($command eq 'whoami') {
                $output .= "rdnuser\n";
            } elsif ($command eq 'date') {
                $output .= `date`;
            } elsif ($command eq 'uptime') {
                $output .= `uptime`;
            } elsif ($command =~ /^ls/) {
                $output .= "bin  boot  dev  etc  home  lib  media  mnt  opt  proc  root  run  sbin  srv  sys  tmp  usr  var\n";
            } else {
                $output .= "Command output would appear here...\n";
            }
        }
    };
    
    if ($@) {
        return {
            success => 0,
            error => "Command execution failed: $@"
        };
    }
    
    # Log command execution
    log_command_execution($host_id, $command, $output);
    
    return {
        success => 1,
        output => $output || "Command completed with no output"
    };
}

sub get_host_info {
    my $host_id = shift;
    
    my $dbh = DBI->connect("DBI:mysql:$rdn_db_schema:$rdn_db_host:$rdn_db_port", $rdn_db_user, $rdn_db_pass);
    if (!$dbh) {
        return { _error => "Database connection failed: $DBI::errstr", _host_id => $host_id };
    }
    
    my $sth = $dbh->prepare("SELECT id, name, type, os, fqdn, status FROM _hosts WHERE id = ?");
    $sth->execute($host_id);
    
    my ($id, $name, $type, $os, $fqdn, $status) = $sth->fetchrow_array();
    $sth->finish();
    $dbh->disconnect();
    
    if ($id) {
        return {
            id => $id,
            name => $name,
            type => $type,
            os => $os,
            fqdn => $fqdn,
            status => $status
        };
    }
    
    return { _error => "No host found with id $host_id", _host_id => $host_id };
}

sub log_command_execution {
    my ($host_id, $command, $output) = @_;
    
    eval {
        my $dbh = DBI->connect("DBI:mysql:$rdn_db_schema:$rdn_db_host:$rdn_db_port", $rdn_db_user, $rdn_db_pass);
        
        # Generate a unique command ID
        my $command_id = 'cmd_' . time() . '_' . int(rand(1000));
        
        my $sth = $dbh->prepare("
            INSERT INTO _commands (command_id, host_id, command, output, status, user_id, created_at) 
            VALUES (?, ?, ?, ?, 'completed', 1, NOW())
        ");
        $sth->execute($command_id, $host_id, $command, $output);
        $sth->finish();
        $dbh->disconnect();
    };
    if ($@) {
        # Log error but don't fail the main operation
        warn "Failed to log command execution: $@";
    }
}

sub get_json_input {
    my $input = '';
    
    # Get content length
    my $content_length = $ENV{'CONTENT_LENGTH'} || 0;
    
    if ($content_length > 0) {
        # Read POST data directly
        read(STDIN, $input, $content_length);
    }
    
    if ($input) {
        eval {
            my $decoded = $json->decode($input);
            return $decoded;
        };
        if ($@) {
            # If JSON decode fails, try to fix common issues
            $input =~ s/\\"/"/g;  # Remove escaped quotes
            $input =~ s/\\\\/\\/g;  # Remove double escaping
            
            eval {
                my $decoded = $json->decode($input);
                return $decoded;
            };
            
            if ($@) {
                # Still failed, return debug info
                return { 
                    _debug_raw_input => $input, 
                    _decode_error => "$@",
                    _content_length => $content_length 
                };
            }
        }
    }
    
    return { 
        _debug_no_input => 1, 
        _content_length => $content_length,
        _env_method => $ENV{'REQUEST_METHOD'} || 'unknown',
        _input_received => $input
    };
}

