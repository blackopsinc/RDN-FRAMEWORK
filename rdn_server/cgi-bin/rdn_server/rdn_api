use CGI;
use JSON;
use DBI;
require "/var/www/cgi-bin/rdn_server/config.conf";
require "/var/www/cgi-bin/rdn_server/rdn_database";

$rdn = new CGI;
$json = JSON->new->allow_nonref;

# Set JSON content type
print "Content-Type: application/json\n";
print "Access-Control-Allow-Origin: *\n";
print "Access-Control-Allow-Methods: GET, POST, PUT, DELETE, OPTIONS\n";
print "Access-Control-Allow-Headers: Content-Type, X-Requested-With\n\n";

# Get request method and path
$method = $ENV{'REQUEST_METHOD'} || 'GET';
$path_info = $ENV{'PATH_INFO'} || '';
$query_string = $ENV{'QUERY_STRING'} || '';

# Handle OPTIONS request for CORS
if ($method eq 'OPTIONS') {
    exit;
}

# Parse path
@path_parts = split('/', $path_info);
shift @path_parts; # Remove empty first element

$endpoint = $path_parts[0] || '';
$resource = $path_parts[1] || '';
$action = $path_parts[2] || '';

# Route requests
if ($endpoint eq 'dashboard') {
    handle_dashboard($resource);
} elsif ($endpoint eq 'hosts') {
    handle_hosts($resource, $action);
} elsif ($endpoint eq 'console') {
    handle_console($resource);
} elsif ($endpoint eq 'files') {
    handle_files($resource, $action);
} elsif ($endpoint eq 'audit') {
    handle_audit($resource);
} elsif ($endpoint eq 'settings') {
    handle_settings($resource);
} else {
    send_error("Unknown endpoint: $endpoint", 404);
}

sub handle_dashboard {
    my $resource = shift;
    
    if ($resource eq 'stats') {
        # Get dashboard statistics
        my $stats = {
            activeHosts => get_active_hosts_count(),
            commandsToday => get_commands_today_count(),
            pendingTasks => get_pending_tasks_count(),
            failedCommands => get_failed_commands_count()
        };
        send_json($stats);
    } elsif ($resource eq 'activity') {
        # Get recent activity
        my $activity = get_recent_activity();
        send_json($activity);
    } else {
        send_error("Unknown dashboard resource: $resource", 404);
    }
}

sub handle_hosts {
    my ($resource, $action) = @_;
    
    if ($method eq 'GET' && !$resource) {
        # Get all hosts
        my $hosts = get_all_hosts();
        send_json($hosts);
    } elsif ($method eq 'POST' && !$resource) {
        # Create new host
        my $input = get_json_input();
        my $result = create_host($input);
        send_json($result);
    } elsif ($method eq 'POST' && $action eq 'test') {
        # Test host connection
        my $result = test_host($resource);
        send_json($result);
    } elsif ($method eq 'PUT' && $resource) {
        # Update host
        my $input = get_json_input();
        my $result = update_host($resource, $input);
        send_json($result);
    } elsif ($method eq 'GET' && $resource) {
        # Get single host
        my $host = get_host($resource);
        send_json($host);
    } elsif ($method eq 'DELETE' && $resource) {
        # Delete host
        my $result = delete_host($resource);
        send_json($result);
    } else {
        send_error("Invalid hosts request", 400);
    }
}

sub handle_console {
    my $resource = shift;
    
    if ($resource eq 'execute') {
        my $input;
        
        if ($method eq 'POST') {
            $input = get_json_input();
        } else {
            # Also support GET with query parameters for testing
            $input = {
                host_id => $rdn->param('host_id') || '',
                command => $rdn->param('command') || ''
            };
        }
        
        my $result = execute_console_command($input);
        send_json($result);
    } else {
        send_error("Invalid console request", 400);
    }
}

sub get_active_hosts_count {
