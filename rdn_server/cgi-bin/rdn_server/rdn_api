sub get_recent_activity {
    my @activity = ();
    eval {
        my $dbh = DBI->connect("DBI:mysql:$rdn_db_schema:$rdn_db_host:$rdn_db_port", $rdn_db_user, $rdn_db_pass);
        my $sth = $dbh->prepare("
            SELECT c.created_at, h.name, c.command, c.status, u.username 
            FROM _commands c 
            LEFT JOIN _hosts h ON c.host_id = h.id 
            LEFT JOIN _users u ON c.user_id = u.id 
            ORDER BY c.created_at DESC 
            LIMIT 10
        ");
        $sth->execute();
        
        while (my ($timestamp, $host, $command, $status, $user) = $sth->fetchrow_array()) {
            push @activity, {
                timestamp => $timestamp,
                host => $host || 'Unknown',
                command => $command || '',
                status => $status || 'unknown',
                user => $user || 'Unknown'
            };
        }
        
        $sth->finish();
        $dbh->disconnect();
    };
    return \@activity;
}

sub get_all_hosts {
    my @hosts = ();
    eval {
        my $dbh = DBI->connect("DBI:mysql:$rdn_db_schema:$rdn_db_host:$rdn_db_port", $rdn_db_user, $rdn_db_pass);
        my $sth = $dbh->prepare("SELECT id, name, type, os, fqdn, status, last_seen FROM _hosts ORDER BY name");
        $sth->execute();
        
        while (my ($id, $name, $type, $os, $fqdn, $status, $last_seen) = $sth->fetchrow_array()) {
            push @hosts, {
                id => $id,
                name => $name,
                type => $type,
                os => $os,
                fqdn => $fqdn,
                status => $status,
                last_seen => $last_seen
            };
        }
        
        $sth->finish();
        $dbh->disconnect();
    };
    return \@hosts;
}

sub create_host {
    my $input = shift;
    
    eval {
        my $dbh = DBI->connect("DBI:mysql:$rdn_db_schema:$rdn_db_host:$rdn_db_port", $rdn_db_user, $rdn_db_pass);
        my $sth = $dbh->prepare("
            INSERT INTO _hosts (name, type, os, fqdn, connection_string, status) 
            VALUES (?, ?, ?, ?, ?, 'active')
        ");
        $sth->execute($input->{name}, $input->{type}, $input->{os}, $input->{fqdn}, $input->{connection_string});
        $sth->finish();
        $dbh->disconnect();
        
        return { success => 1, message => "Host created successfully" };
    };
    
    return { success => 0, error => "Failed to create host: $@" };
}

