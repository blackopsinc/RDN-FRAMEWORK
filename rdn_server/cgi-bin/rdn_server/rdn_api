sub get_file_list {
    my $path = shift;
    my @files = ();
    
    # Security check - only allow certain directories
    unless ($path =~ /^\/var\/www/ || $path =~ /^\/tmp/ || $path =~ /^\/home/) {
        return { error => "Access denied to path: $path" };
    }
    
    eval {
        opendir(my $dh, $path) or die "Cannot open directory $path: $!";
        while (my $file = readdir($dh)) {
            next if $file =~ /^\.\.?$/; # Skip . and ..
            
            my $full_path = "$path/$file";
            my @stat = stat($full_path);
            
            push @files, {
                name => $file,
                path => $full_path,
                type => (-d $full_path) ? 'directory' : 'file',
                size => $stat[7] || 0,
                modified => $stat[9] || 0,
                permissions => sprintf("%04o", $stat[2] & 07777)
            };
        }
        closedir($dh);
    };
    
    if ($@) {
        return { error => "Failed to list files: $@" };
    }
    
    return \@files;
}

sub get_audit_logs {
    my @logs = ();
    eval {
        my $dbh = DBI->connect("DBI:mysql:$rdn_db_schema:$rdn_db_host:$rdn_db_port", $rdn_db_user, $rdn_db_pass);
        my $sth = $dbh->prepare("
            SELECT timestamp, event_type, severity, client_ip, user_id, host_id, command, response_code
            FROM _audit 
            ORDER BY timestamp DESC 
            LIMIT 100
        ");
        $sth->execute();
        
        while (my ($timestamp, $event_type, $severity, $client_ip, $user_id, $host_id, $command, $response_code) = $sth->fetchrow_array()) {
            push @logs, {
                timestamp => $timestamp,
                event_type => $event_type,
                severity => $severity,
                client_ip => $client_ip,
                user_id => $user_id,
                host_id => $host_id,
                command => $command,
                response_code => $response_code
            };
        }
        
        $sth->finish();
        $dbh->disconnect();
    };
    return \@logs;
}

sub get_system_settings {
    my @settings = ();
    eval {
        my $dbh = DBI->connect("DBI:mysql:$rdn_db_schema:$rdn_db_host:$rdn_db_port", $rdn_db_user, $rdn_db_pass);
        my $sth = $dbh->prepare("
            SELECT config_key, config_value, config_type, description, is_sensitive
            FROM _system_config 
            ORDER BY config_key
        ");
        $sth->execute();
        
        while (my ($key, $value, $type, $description, $is_sensitive) = $sth->fetchrow_array()) {
            push @settings, {
                key => $key,
                value => $is_sensitive ? '***' : $value,
                type => $type,
                description => $description,
                is_sensitive => $is_sensitive
            };
        }
        
        $sth->finish();
        $dbh->disconnect();
    };
    return \@settings;
}

sub update_system_settings {
    my $input = shift;
    
    eval {
        my $dbh = DBI->connect("DBI:mysql:$rdn_db_schema:$rdn_db_host:$rdn_db_port", $rdn_db_user, $rdn_db_pass);
        
        foreach my $setting (@{$input->{settings}}) {
            my $sth = $dbh->prepare("
                UPDATE _system_config 
                SET config_value = ?, updated_at = NOW(), updated_by = 1 
                WHERE config_key = ?
            ");
            $sth->execute($setting->{value}, $setting->{key});
            $sth->finish();
        }
        
        $dbh->disconnect();
        return { success => 1, message => "Settings updated successfully" };
    };
    
    return { success => 0, error => "Failed to update settings: $@" };
}

sub send_json {
    my $data = shift;
    print $json->encode($data);
}

sub send_error {
    my ($message, $code) = @_;
    $code ||= 500;
    
    print "Status: $code\n\n";
    print $json->encode({ error => $message, code => $code });
}
