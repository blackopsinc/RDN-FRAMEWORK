#!/usr/bin/perl

use strict;
use warnings;
use CGI;
use JSON;
use DBI;

# Database configuration - direct values to avoid config issues
my $rdn_db_schema = "rdn";
my $rdn_db_host = "172.20.0.200";
my $rdn_db_port = "3306";
my $rdn_db_user = "root";
my $rdn_db_pass = "changeme";

my $json = JSON->new->allow_nonref;

# Set JSON content type and CORS headers
print "Content-Type: application/json\n";
print "Access-Control-Allow-Origin: *\n";
print "Access-Control-Allow-Methods: GET, POST, PUT, DELETE, OPTIONS\n";
print "Access-Control-Allow-Headers: Content-Type, X-Requested-With\n\n";

# Get request method and path
my $method = $ENV{'REQUEST_METHOD'} || 'GET';
my $path_info = $ENV{'PATH_INFO'} || '';

# Handle OPTIONS request for CORS
if ($method eq 'OPTIONS') {
    exit;
}

# Parse path
my @path_parts = split('/', $path_info);
shift @path_parts; # Remove empty first element

my $endpoint = $path_parts[0] || '';
my $resource = $path_parts[1] || '';
my $action = $path_parts[2] || '';

# Route requests
if ($endpoint eq 'dashboard') {
    handle_dashboard($resource);
} elsif ($endpoint eq 'hosts') {
    handle_hosts($resource, $action);
} elsif ($endpoint eq 'console') {
    handle_console($resource);
} elsif ($endpoint eq 'audit') {
    handle_audit($resource);
} else {
    send_error("Unknown endpoint: $endpoint", 404);
}

sub handle_dashboard {
    my $resource = shift;

    if ($resource eq 'stats') {
        my $stats = {
            activeHosts => get_active_hosts_count(),
            commandsToday => get_commands_today_count(),
            pendingTasks => 0,
            failedCommands => 0
        };
        send_json($stats);
    } elsif ($resource eq 'activity') {
        my $activity = get_recent_activity();
        send_json($activity);
    } else {
        send_error("Unknown dashboard resource: $resource", 404);
    }
}

sub handle_hosts {
    my ($resource, $action) = @_;

    if ($method eq 'GET' && !$resource) {
        # Get all hosts
        my $hosts = get_all_hosts();
        send_json($hosts);
    } elsif ($method eq 'POST' && !$resource) {
        # Create new host
        my $input = get_post_data();
        my $result = create_host($input);
        send_json($result);
    } elsif ($method eq 'POST' && $action eq 'test') {
        # Test host connection
        my $result = test_host($resource);
        send_json($result);
    } elsif ($method eq 'PUT' && $resource) {
        # Update host
        my $input = get_post_data();
        my $result = update_host($resource, $input);
        send_json($result);
    } elsif ($method eq 'GET' && $resource) {
        # Get single host
        my $host = get_host($resource);
        send_json($host);
    } elsif ($method eq 'DELETE' && $resource) {
        # Delete host
        my $result = delete_host($resource);
        send_json($result);
    } else {
        send_error("Invalid hosts request", 400);
    }
}

sub handle_console {
    my $resource = shift;

    if ($resource eq 'execute') {
        my $input;

        if ($method eq 'POST') {
            $input = get_post_data();
        } else {
            # Support GET with query parameters
            my $cgi = CGI->new;
            $input = {
                host_id => $cgi->param('host_id') || '',
                command => $cgi->param('command') || ''
            };
        }

        my $result = execute_console_command($input);
        send_json($result);
    } else {
        send_error("Invalid console request", 400);
    }
}

sub get_post_data {
    my %data = ();
    
    if ($method eq 'POST' || $method eq 'PUT') {
        my $content_length = $ENV{'CONTENT_LENGTH'} || 0;
        
        if ($content_length > 0) {
            my $raw_data = '';
            read(STDIN, $raw_data, $content_length);
            
            # Try to parse as JSON first
            if ($raw_data && $raw_data =~ /^\s*\{/) {
                eval {
                    my $parsed = $json->decode($raw_data);
                    if (ref($parsed) eq 'HASH') {
                        %data = %$parsed;
                    }
                };
                if ($@) {
                    # JSON parsing failed, return debug info
                    return {
                        _error => "JSON parsing failed: $@",
                        _raw_data => $raw_data,
                        _content_length => $content_length
                    };
                }
            } else {
                # Try as form data
                my $cgi = CGI->new($raw_data);
                foreach my $param ($cgi->param()) {
                    $data{$param} = $cgi->param($param);
                }
            }
        }
    }
    
    return \%data;
}

sub get_active_hosts_count {
    my $count = 0;
    eval {
        my $dbh = DBI->connect("DBI:mysql:$rdn_db_schema:$rdn_db_host:$rdn_db_port", $rdn_db_user, $rdn_db_pass);
        if ($dbh) {
            my $sth = $dbh->prepare("SELECT COUNT(*) FROM _hosts WHERE status = 'active'");
            $sth->execute();
            ($count) = $sth->fetchrow_array();
            $sth->finish();
            $dbh->disconnect();
        }
    };
    return $count || 0;
}

sub get_commands_today_count {
    my $count = 0;
    eval {
        my $dbh = DBI->connect("DBI:mysql:$rdn_db_schema:$rdn_db_host:$rdn_db_port", $rdn_db_user, $rdn_db_pass);
        if ($dbh) {
            my $sth = $dbh->prepare("SELECT COUNT(*) FROM _commands WHERE DATE(created_at) = CURDATE()");
            $sth->execute();
            ($count) = $sth->fetchrow_array();
            $sth->finish();
            $dbh->disconnect();
        }
    };
    return $count || 0;
}

sub get_recent_activity {
    my @activity = ();
    eval {
        my $dbh = DBI->connect("DBI:mysql:$rdn_db_schema:$rdn_db_host:$rdn_db_port", $rdn_db_user, $rdn_db_pass);
        if ($dbh) {
            my $sth = $dbh->prepare("
                SELECT c.created_at, h.name, c.command, c.status, u.username
                FROM _commands c
                LEFT JOIN _hosts h ON c.host_id = h.id
                LEFT JOIN _users u ON c.user_id = u.id
                ORDER BY c.created_at DESC
                LIMIT 10
            ");
            $sth->execute();

            while (my ($timestamp, $host, $command, $status, $user) = $sth->fetchrow_array()) {
                push @activity, {
                    timestamp => $timestamp,
                    host => $host || 'Unknown',
                    command => $command || '',
                    status => $status || 'unknown',
                    user => $user || 'Unknown'
                };
            }

            $sth->finish();
            $dbh->disconnect();
        }
    };
    return \@activity;
}

sub get_all_hosts {
    my @hosts = ();
    eval {
        my $dbh = DBI->connect("DBI:mysql:$rdn_db_schema:$rdn_db_host:$rdn_db_port", $rdn_db_user, $rdn_db_pass);
        if ($dbh) {
            my $sth = $dbh->prepare("SELECT id, name, type, os, fqdn, status, last_seen FROM _hosts ORDER BY name");
            $sth->execute();

            while (my ($id, $name, $type, $os, $fqdn, $status, $last_seen) = $sth->fetchrow_array()) {
                push @hosts, {
                    id => $id,
                    name => $name,
                    type => $type,
                    os => $os,
                    fqdn => $fqdn,
                    status => $status,
                    last_seen => $last_seen
                };
            }

            $sth->finish();
            $dbh->disconnect();
        }
    };
    return \@hosts;
}

sub create_host {
    my $input = shift;

    # Check if we have the required fields
    if (!$input->{name} || !$input->{type} || !$input->{os} || !$input->{fqdn}) {
        return { 
            success => 0, 
            error => "Missing required fields: name, type, os, fqdn",
            received => $input
        };
    }

    my $error_msg = '';
    eval {
        my $dbh = DBI->connect("DBI:mysql:$rdn_db_schema:$rdn_db_host:$rdn_db_port", $rdn_db_user, $rdn_db_pass);
        if (!$dbh) {
            die "Database connection failed: " . DBI->errstr;
        }

        my $sth = $dbh->prepare("
            INSERT INTO _hosts (name, type, os, fqdn, connection_string, status)
            VALUES (?, ?, ?, ?, ?, 'active')
        ");
        
        my $result = $sth->execute(
            $input->{name}, 
            $input->{type}, 
            $input->{os}, 
            $input->{fqdn}, 
            $input->{connection_string} || ''
        );
        
        if (!$result) {
            die "Insert failed: " . $sth->errstr;
        }
        
        $sth->finish();
        $dbh->disconnect();
    };

    if ($@) {
        $error_msg = $@;
        # Handle duplicate entry error specifically
        if ($error_msg =~ /Duplicate entry.*for key/) {
            return { success => 0, error => "Host name already exists. Please choose a different name." };
        }
        return { success => 0, error => "Failed to create host: $error_msg" };
    }

    return { success => 1, message => "Host created successfully" };
}

sub test_host {
    my $host_id = shift;

    eval {
        my $dbh = DBI->connect("DBI:mysql:$rdn_db_schema:$rdn_db_host:$rdn_db_port", $rdn_db_user, $rdn_db_pass);
        if ($dbh) {
            my $sth = $dbh->prepare("UPDATE _hosts SET last_seen = NOW() WHERE id = ?");
            $sth->execute($host_id);
            $sth->finish();
            $dbh->disconnect();

            return { success => 1, message => "Host test successful" };
        }
    };

    return { success => 0, error => "Host test failed: $@" };
}

sub get_host {
    my $host_id = shift;

    eval {
        my $dbh = DBI->connect("DBI:mysql:$rdn_db_schema:$rdn_db_host:$rdn_db_port", $rdn_db_user, $rdn_db_pass);
        if ($dbh) {
            my $sth = $dbh->prepare("SELECT id, name, type, os, fqdn, connection_string, status, last_seen FROM _hosts WHERE id = ?");
            $sth->execute($host_id);

            my ($id, $name, $type, $os, $fqdn, $connection_string, $status, $last_seen) = $sth->fetchrow_array();
            $sth->finish();
            $dbh->disconnect();

            if ($id) {
                return {
                    id => $id,
                    name => $name,
                    type => $type,
                    os => $os,
                    fqdn => $fqdn,
                    connection_string => $connection_string,
                    status => $status,
                    last_seen => $last_seen
                };
            }
        }
    };

    return { error => "Host not found" };
}

sub update_host {
    my ($host_id, $input) = @_;

    # Check if we have the required fields
    if (!$input->{name} || !$input->{type} || !$input->{os} || !$input->{fqdn}) {
        return { 
            success => 0, 
            error => "Missing required fields: name, type, os, fqdn" 
        };
    }

    eval {
        my $dbh = DBI->connect("DBI:mysql:$rdn_db_schema:$rdn_db_host:$rdn_db_port", $rdn_db_user, $rdn_db_pass);
        if ($dbh) {
            my $sth = $dbh->prepare("
                UPDATE _hosts
                SET name = ?, type = ?, os = ?, fqdn = ?, connection_string = ?, updated_at = NOW()
                WHERE id = ?
            ");
            $sth->execute(
                $input->{name}, 
                $input->{type}, 
                $input->{os}, 
                $input->{fqdn}, 
                $input->{connection_string} || '', 
                $host_id
            );
            $sth->finish();
            $dbh->disconnect();

            return { success => 1, message => "Host updated successfully" };
        }
    };

    return { success => 0, error => "Failed to update host: $@" };
}

