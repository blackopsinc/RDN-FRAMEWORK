            # Get command executions as audit logs
            my $sth = $dbh->prepare("
                SELECT c.created_at, c.command, h.name as host_name, u.username, c.status
                FROM _commands c
                LEFT JOIN _hosts h ON c.host_id = h.id
                LEFT JOIN _users u ON c.user_id = u.id
