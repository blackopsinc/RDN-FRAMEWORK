}

sub log_command_execution {
    my ($host_id, $command, $output) = @_;

    eval {
        my $dbh = DBI->connect("DBI:mysql:$rdn_db_schema:$rdn_db_host:$rdn_db_port", $rdn_db_user, $rdn_db_pass);
        if ($dbh) {
            my $command_id = 'cmd_' . time() . '_' . int(rand(1000));

            my $sth = $dbh->prepare("
                INSERT INTO _commands (command_id, host_id, command, output, status, user_id, created_at)
                VALUES (?, ?, ?, ?, 'completed', 1, NOW())
            ");
            $sth->execute($command_id, $host_id, $command, $output);
            $sth->finish();
            $dbh->disconnect();
        }
    };
}

sub send_json {
    my $data = shift;
    print $json->encode($data);
}

sub send_error {
    my ($message, $code) = @_;
    $code ||= 500;

    print "Status: $code\n\n";
    print $json->encode({ error => $message, code => $code });
}
