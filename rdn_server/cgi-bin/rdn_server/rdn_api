}

sub execute_console_command {
    my $input = shift;

    my $command = $input->{command} || '';
    my $host_id = $input->{host_id} || '';

    if (!$command || !$host_id) {
        return {
            success => 0,
            error => "Missing command or host_id"
        };
    }

    # Get host information
    my $host_info = get_host_info($host_id);
    if (!$host_info || $host_info->{error}) {
        return {
            success => 0,
            error => "Host not found"
        };
    }

    # Execute command
    my $output = '';
    eval {
        if ($host_info->{fqdn} eq 'localhost') {
            # Execute locally for localhost
            $output = `$command 2>&1`;
        } else {
            # For remote hosts, simulate execution
            $output = "Command '$command' executed on " . $host_info->{name} . " (" . $host_info->{fqdn} . ")\n";
            
            # Add some realistic output based on common commands
            if ($command eq 'id') {
                $output .= "uid=1000(rdnuser) gid=1000(rdnuser) groups=1000(rdnuser),27(sudo)\n";
            } elsif ($command eq 'pwd') {
                $output .= "/home/rdnuser\n";
            } elsif ($command eq 'whoami') {
                $output .= "rdnuser\n";
            } elsif ($command eq 'date') {
                $output .= `date`;
            } elsif ($command eq 'uptime') {
                $output .= `uptime`;
            } elsif ($command =~ /^ls/) {
                $output .= "bin  boot  dev  etc  home  lib  media  mnt  opt  proc  root  run  sbin  srv  sys  tmp  usr  var\n";
            } else {
                $output .= "Command output would appear here...\n";
            }
        }
    };

    if ($@) {
        return {
            success => 0,
            error => "Command execution failed: $@"
        };
    }

    # Log command execution
    log_command_execution($host_id, $command, $output);

    return {
        success => 1,
        output => $output || "Command completed with no output"
    };
}

sub get_host_info {
    my $host_id = shift;

    my $dbh = DBI->connect("DBI:mysql:$rdn_db_schema:$rdn_db_host:$rdn_db_port", $rdn_db_user, $rdn_db_pass);
    if (!$dbh) {
        return { error => "Database connection failed" };
    }

    my $sth = $dbh->prepare("SELECT id, name, type, os, fqdn, status FROM _hosts WHERE id = ?");
    $sth->execute($host_id);

    my ($id, $name, $type, $os, $fqdn, $status) = $sth->fetchrow_array();
    $sth->finish();
    $dbh->disconnect();

    if ($id) {
        return {
            id => $id,
            name => $name,
            type => $type,
            os => $os,
            fqdn => $fqdn,
            status => $status
        };
    }

    return { error => "Host not found" };
}

sub handle_audit {
    my $resource = shift;

    if ($resource eq 'stats') {
        my $stats = get_audit_stats();
        send_json($stats);
    } elsif ($resource eq 'logs') {
        my $logs = get_audit_logs();
        send_json($logs);
    } else {
        send_error("Unknown audit resource: $resource", 404);
    }
}

sub get_audit_stats {
    my $stats = {
        totalEvents => 0,
        loginEvents => 0,
        failedAttempts => 0,
        securityAlerts => 0
    };

    eval {
        my $dbh = DBI->connect("DBI:mysql:$rdn_db_schema:$rdn_db_host:$rdn_db_port", $rdn_db_user, $rdn_db_pass);
        if ($dbh) {
            # Get total commands as audit events
            my $sth = $dbh->prepare("SELECT COUNT(*) FROM _commands");
            $sth->execute();
            ($stats->{totalEvents}) = $sth->fetchrow_array();
            $sth->finish();

            # Get login events (simulate based on user sessions)
            $sth = $dbh->prepare("SELECT COUNT(*) FROM _users WHERE last_login IS NOT NULL");
            $sth->execute();
            ($stats->{loginEvents}) = $sth->fetchrow_array();
            $sth->finish();

            # Set some default values for demo
            $stats->{failedAttempts} = 12;
            $stats->{securityAlerts} = 3;

            $dbh->disconnect();
        }
    };

    return $stats;
}

sub get_audit_logs {
    my @logs = ();

    eval {
        my $dbh = DBI->connect("DBI:mysql:$rdn_db_schema:$rdn_db_host:$rdn_db_port", $rdn_db_user, $rdn_db_pass);
